{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex Mobile Bridge",
  "version": "0.1.14",
  "identifier": "com.damon.codex-mobile-bridge",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:57325",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Codex Mobile Bridge",
        "width": 1040,
        "height": 760,
        "minWidth": 860,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "resources": {
      "resources/bin/": "bin/",
      "resources/mobile-pwa/": "mobile-pwa/"
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
